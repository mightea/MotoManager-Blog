---
import Base from "../layouts/Base.astro";
import Versions from "../components/Versions.astro";
import { getPosts, postPath, withBase, formatDate } from "../lib/posts";

const posts = await getPosts();
---

<Base title="MotoManager Releases" description="What's new in MotoManager — web app, API and iOS app.">
  <section class="intro">
    <h1>What's new in MotoManager</h1>
    <p>One post per month, covering the web app, the API and the iOS app. Patch releases are added to that month's post.</p>
  </section>

  <ol class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={withBase(postPath(post))}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <Versions versions={post.data.versions} />
          </a>
        </li>
      ))
    }
  </ol>
</Base>
