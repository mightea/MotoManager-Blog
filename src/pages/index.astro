---
import Base from "../layouts/Base.astro";
import Versions from "../components/Versions.astro";
import { getPosts, postPath, withBase, formatDate } from "../lib/posts";

const posts = await getPosts();
---

<Base title="MotoManager Releases" description="What's new in MotoManager — web app and iOS app.">
  <section class="intro">
    <span class="label-tag">Release notes</span>
    <h1 class="font-display">What's new in MotoManager</h1>
    <p>One post per month for the web app and the iOS app. Smaller updates are added to that month's post.</p>
  </section>

  <ol class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="card post-card" href={withBase(postPath(post))}>
            <span class="motorsport-stripe-v card-rail" aria-hidden="true" />
            <time class="label-tag" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <Versions versions={post.data.versions} />
          </a>
        </li>
      ))
    }
  </ol>
</Base>
